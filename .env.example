# Inbox for both the contact form and the prescription form.
# Without RESEND_API_KEY and CONTACT_FROM the forms stay on screen
# and tell the visitor to email pharmacie@ginkgo.lu instead.

# API key from https://resend.com — never commit a real key.
RESEND_API_KEY=

# Verified sender on the domain you send from, for example:
# Pharmacie Ginkgo <pharmacie@ginkgo.lu>
CONTACT_FROM=

# Optional. Defaults to pharmacie@ginkgo.lu.
CONTACT_TO=pharmacie@ginkgo.lu
